//! net/http — HTTP protocol primitives.
//!
//! Status: M4 (stdlib/SPEC.md §9 reserves net/* for M4/M5). This module
//! defines the type-level vocabulary for HTTP requests and responses.
//! The transport layer (net.http.client) provides send/receive; this
//! file is the shared vocabulary both sides depend on.
//!
//! No native builtins required — pure enum/struct definitions with
//! accessor functions (C1: free functions only, no method-call syntax).

/// HTTP request methods (RFC 7231).
/// Stringify via `http_method_string`.
HttpMethod:
    Get
    Post
    Put
    Delete
    Patch
    Head
    Options

/// Render an HTTP method as its canonical string.
fn http_method_string(m: HttpMethod) -> String:
    match m:
        HttpMethod.Get(): "GET"
        HttpMethod.Post(): "POST"
        HttpMethod.Put(): "PUT"
        HttpMethod.Delete(): "DELETE"
        HttpMethod.Patch(): "PATCH"
        HttpMethod.Head(): "HEAD"
        HttpMethod.Options(): "OPTIONS"

/// Parse a method string; returns None for unknown methods.
fn http_method_from_string(s: String) -> Option<String>:
    match s:
        "GET": Some("Get")
        "POST": Some("Post")
        "PUT": Some("Put")
        "DELETE": Some("Delete")
        "PATCH": Some("Patch")
        "HEAD": Some("Head")
        "OPTIONS": Some("Options")
        _: None

/// An HTTP request: method, URL, optional headers, optional body.
HttpRequest:
    method: String    // canonical method string ("GET", "POST", ...)
    url: String
    headers: [(String, String)]
    body: Option<String>

/// An HTTP response: status code, reason phrase, headers, body.
HttpResponse:
    status: Int
    reason: String
    headers: [(String, String)]
    body: String
