//! net/http — HTTP protocol primitives.
//!
//! Status: runnable M4 surface (SPEC.md §5.13). This module defines
//! the type-level vocabulary for HTTP requests and responses. The
//! transport layer (net.http.client) provides send/receive; this
//! file is the shared vocabulary both sides depend on.
//!
//! No native builtins required — pure enum/struct definitions with
//! accessor functions (C1: free functions only, no method-call syntax).
//!
//! Header pairs are `[[String]]` (lists of 2-lists): tuple VALUES are
//! unimplemented (the parser keeps only the first element), so pairs
//! are spelled as 2-lists everywhere, matching `http_send_builtin`.

/// HTTP request methods (RFC 7231).
/// Stringify via `http_method_string`.
enum HttpMethod:
    Get
    Post
    Put
    Delete
    Patch
    Head
    Options

/// Render an HTTP method as its canonical string.
/// Arms use the `Variant():` form — bare `Get:` would parse as a
/// binding swallowing every method (the L-001 trap).
fn http_method_string(m: HttpMethod) -> String:
    match m:
        Get(): "GET"
        Post(): "POST"
        Put(): "PUT"
        Delete(): "DELETE"
        Patch(): "PATCH"
        Head(): "HEAD"
        Options(): "OPTIONS"

/// Parse a method string; returns None for unknown methods.
fn http_method_from_string(s: String) -> Option<String>:
    match s:
        "GET": Some("Get")
        "POST": Some("Post")
        "PUT": Some("Put")
        "DELETE": Some("Delete")
        "PATCH": Some("Patch")
        "HEAD": Some("Head")
        "OPTIONS": Some("Options")
        _: None

/// An HTTP request: method, URL, optional headers, optional body.
HttpRequest:
    method: String
    url: String
    headers: [[String]]
    body: Option<String>

/// An HTTP response: status code, reason phrase, headers, body.
HttpResponse:
    status: Int
    reason: String
    headers: [[String]]
    body: String
