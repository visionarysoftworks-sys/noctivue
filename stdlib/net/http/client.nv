//! net/http/client — HTTP client operations.
//!
//! Status: runnable M4 surface (SPEC.md §5.13). These functions call
//! `http_send_builtin` (blocking TCP over plaintext HTTP; `https://`
//! is refused loudly — there is no TLS stack yet).
//!
//! Header pairs are `[[String]]` (lists of 2-lists): tuple VALUES are
//! unimplemented (the parser keeps only the first element), so pairs
//! are spelled as 2-lists everywhere, matching the builtin.

/// Perform an HTTP GET request. Returns Err on connection failure.
/// Returns the response BODY text only: status codes and response
/// headers are not visible in M4 (unmatched routes answer 404 with a
/// "Not Found" body, still `Ok`). A status-aware client is M5 work.
fn http_get(url: String) -> Result<String, String>:
    http_get_with_headers(url, [])

/// Perform an HTTP GET request with custom headers.
fn http_get_with_headers(url: String, headers: [[String]]) -> Result<String, String>:
    http_request("GET", url, headers, "")

/// Perform an HTTP POST request with a body.
fn http_post(url: String, body: String) -> Result<String, String>:
    http_post_with_headers(url, [], body)

/// Perform an HTTP POST request with custom headers and a body.
fn http_post_with_headers(url: String, headers: [[String]], body: String) -> Result<String, String>:
    http_request("POST", url, headers, body)

/// Perform an HTTP PUT request.
fn http_put(url: String, body: String) -> Result<String, String>:
    http_request("PUT", url, [], body)

/// Perform an HTTP DELETE request.
fn http_delete(url: String) -> Result<String, String>:
    http_request("DELETE", url, [], "")

/// Low-level request builder used by all higher-level helpers.
/// Method is the canonical string ("GET", "POST", ...). Headers pass
/// straight through; when the body is non-empty and no Content-Type
/// is present, the builtin supplies `text/plain` (the language has
/// no list-append yet, so callers cannot merge one in).
fn http_request(method: String, url: String, headers: [[String]], body: String) -> Result<String, String>:
    http_send_builtin(method, url, headers, body)

/// Send an HTTP request. Thin alias over `http_request` kept for the
/// older surface: same passthrough, same builtin Content-Type rule.
fn http_send(method: String, url: String, headers: [[String]], body: String) -> Result<String, String>:
    http_request(method, url, headers, body)
