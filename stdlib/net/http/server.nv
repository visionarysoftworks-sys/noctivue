//! net/http/server — minimal HTTP server scaffolding.
//!
//! Status: runnable M4 surface (SPEC.md §5.13). Handler-based routing
//! over `http_server_*` builtins: `http_server_serve` blocks the
//! calling thread, so production use runs it in a `task` and stops it
//! via `http_server_stop` from another thread.

/// A handler function takes the request BODY as a String and
/// returns the response body String. Registered by exact
/// method + path (unmatched requests get 404).
/// Handlers are registered by route path.

/// Start listening on the given port. Returns a server handle (opaque).
fn http_server_start(port: Int) -> Result<Int, String>:
    http_server_listen(port)

/// Register a handler for a route prefix. The handler is a free function
/// name that takes a String (request body) and returns String (response body).
fn http_server_route(server: Int, method: String, path_pattern: String, handler: String):
    http_server_register_route(server, method, path_pattern, handler)

/// Run the event loop (blocks until stopped). Returns when stopped.
/// Blocking means the calling thread: register routes BEFORE serving
/// (routes insert into a shared table, so registering from `main`
/// then serving in a `task` has no race — the listener backlog holds
/// early connections), and always `http_server_stop` before `await`.
fn http_server_serve(server: Int):
    http_server_serve_loop(server)

/// Stop the server and release the port.
fn http_server_stop(server: Int):
    http_server_shutdown(server)
