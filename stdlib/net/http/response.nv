//! net/http/response — HTTP response helpers.
//!
//! Status: runnable M4 surface (SPEC.md §5.13).
//! Parses and builds HTTP response strings. Depends on the
//! `HttpResponse` struct from `net/http/request.nv`.

/// Build a response from status code + body.
fn http_response(status: Int, body: String) -> HttpResponse:
    HttpResponse {
        status: status,
        reason: http_reason_phrase(status),
        headers: [],
        body: body
    }

/// Build a status-aware response with custom headers.
/// The handler returning this value answers with exactly `status`,
/// `headers` verbatim (in order), and `body`: e.g. a 201 Created
/// with a Location header. `Content-Length`/`Connection` must not be
/// supplied (the wire layer owns framing and skips them loudly);
/// `status` must be 100..=599 and names/values must be framing-clean,
/// else the server answers 500 for the handler's bug — never a
/// half-framed response.
fn http_response_with_headers(status: Int, headers: [[String]], body: String) -> HttpResponse:
    HttpResponse {
        status: status,
        reason: http_reason_phrase(status),
        headers: headers,
        body: body
    }

/// Map a status code to its reason phrase (RFC 7230 §3.1.2).
fn http_reason_phrase(status: Int) -> String:
    match status:
        200: "OK"
        201: "Created"
        204: "No Content"
        301: "Moved Permanently"
        302: "Found"
        304: "Not Modified"
        400: "Bad Request"
        401: "Unauthorized"
        403: "Forbidden"
        404: "Not Found"
        405: "Method Not Allowed"
        413: "Payload Too Large"
        500: "Internal Server Error"
        501: "Not Implemented"
        502: "Bad Gateway"
        503: "Service Unavailable"
        _: "Unknown"

/// True when the response indicates success (2xx).
fn http_is_success(r: HttpResponse) -> Bool:
    r.status >= 200 && r.status < 300
