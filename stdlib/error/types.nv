//! error/types — structured error records.
//!
//! Status: runnable M4 foundation. Trait-based error dispatch remains
//! reserved (requires trait/impl support — SPEC.md C4, deferred).
//! The standard convention for fallible functions is `Result<T, String>`
//! (E3 per SPEC.md §4). Application-specific error enums are permitted
//! but the stdlib uses `Result<T, String>` exclusively.
//!
//! M3 error convention (SPEC.md §4, "Error conventions"):
//! - E1: `panic(msg)` for violated preconditions / invariant failures.
//! - E2: `Option<T>` for absence-is-not-error.
//! - E3: `Result<T, String>` for foundation fallible fns that must explain failure.
//! - E4: `?` / `??` are the only propagation tools; no exceptions.
//!
//! Lint rule L-005 (default-off): flags fallible functions returning
//! `Result<T, E>` where `E` is not `String` and not `ErrorInfo` —
//! these are ad-hoc error shapes that should either use `String` or
//! be documented as intentional exceptions.
ErrorInfo:
    code: String
    message: String
    source: String

/// Create a structured error record.
fn error_info(code: String, message: String, source: String) -> ErrorInfo:
    ErrorInfo { code: code, message: message, source: source }

/// Render an error for logs and diagnostics.
fn error_info_display(error: ErrorInfo) -> String:
    if error.source.length == 0:
        error.code + ": " + error.message
    else:
        error.source + ": " + error.code + ": " + error.message

/// Add context while preserving the original error code.
fn error_info_context(error: ErrorInfo, context: String) -> ErrorInfo:
    ErrorInfo {
        code: error.code,
        message: error.message + ": " + context,
        source: error.source
    }
