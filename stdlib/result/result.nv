//! result — helpers for Result<T, E> (recoverable errors).
//!
//! Status: runnable (M3 foundation, stdlib/SPEC.md §5.5). M3 error type
//! is String (SPEC.md E3); per-module error enums arrive with M4.
//! Match arms use the Variant(): form (SPEC.md C8, S6).

/// True when the result is Ok (Int ok type).
fn result_is_ok(r: Result<Int, String>) -> Bool:
    match r:
        Ok(_): true
        Err(_): false

/// True when the result is Ok (String ok type).
fn result_is_ok_string(r: Result<String, String>) -> Bool:
    match r:
        Ok(_): true
        Err(_): false

/// The ok value, or the fallback when Err.
fn result_unwrap_or(r: Result<Int, String>, fallback: Int) -> Int:
    match r:
        Ok(v): v
        Err(_): fallback

/// The ok value. Panics with msg when Err (SPEC.md E1).
fn result_expect(r: Result<Int, String>, msg: String) -> Int:
    match r:
        Ok(v): v
        Err(_): panic(msg)

/// Apply f to the ok value, pass Err through unchanged.
fn result_map_int(f: (Int) -> Int, r: Result<Int, String>) -> Result<Int, String>:
    match r:
        Ok(v): Ok(f(v))
        Err(e): Err(e)

/// Chain a fallible step: apply f to the ok value, pass Err through.
fn result_and_then_int(f: (Int) -> Result<Int, String>, r: Result<Int, String>) -> Result<Int, String>:
    match r:
        Ok(v): f(v)
        Err(e): Err(e)

/// The first ok result (a when Ok, else b).
fn result_or(a: Result<Int, String>, b: Result<Int, String>) -> Result<Int, String>:
    match a:
        Ok(_): a
        Err(_): b

/// True when the result is exactly Ok(v).
fn result_contains(r: Result<Int, String>, v: Int) -> Bool:
    match r:
        Ok(x): x == v
        Err(_): false
