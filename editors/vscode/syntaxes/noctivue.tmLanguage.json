{
  "scopeName": "source.noctivue",
  "name": "Noctivue",
  "fileTypes": [
    "nv"
  ],
  "patterns": [
    {
      "name": "comment.line.double-slash.noctivue",
      "match": "//.*$"
    },
    {
      "name": "comment.block.noctivue",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "name": "comment.block.noctivue",
          "match": "[^*]*\\*+([^/*][^*]*\\*+)*"
        }
      ]
    },
    {
      "name": "comment.documentation.noctivue",
      "match": "///.*$"
    },
    {
      "name": "string.quoted.double.noctivue",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.noctivue",
          "match": "\\[\"nrt]"
        },
        {
          "name": "punctuation.definition.interpolation.begin.noctivue",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "name": "entity.name.type.noctivue",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "variable.other.noctivue",
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "constant.numeric.integer.noctivue",
              "match": "\\b\\d[\\d_]*\\b"
            }
          ]
        }
      ]
    },
    {
      "name": "string.quoted.single.noctivue",
      "match": "'([^'\\\\]|\\\\.)*'"
    },
    {
      "name": "constant.numeric.float.noctivue",
      "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
    },
    {
      "name": "constant.numeric.integer.noctivue",
      "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|\\d[\\d_]*)\\b"
    },
    {
