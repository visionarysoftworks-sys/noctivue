{
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    { "open": "\"", "close": "\"" }
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*//\\s*#region",
      "end": "^\\s*//\\s*#endregion"
    }
  }
}
