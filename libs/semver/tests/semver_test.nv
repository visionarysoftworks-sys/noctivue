//! Smoke test for semver (run: noct run tests/semver_test.nv,
//! or project mode: noct test from libs/semver).

import version
import requirement

fn check_version(text: String, major: Int, minor: Int, patch: Int):
    match parse_version(text):
        Ok(v):
            assert(v.major == major, "major of {text}"); assert(v.minor == minor, "minor of {text}")
            assert(v.patch == patch, "patch of {text}")
        Err(e): assert(false, "expected {text} to parse: {e}")

fn check_version_err(text: String):
    match parse_version(text):
        Ok(v): assert(false, "expected `{text}` to be rejected, got {v.major}.{v.minor}.{v.patch}")
        Err(_): assert(true, "err as expected")

fn check_satisfied(req: String, ver: String, want: Bool):
    match satisfies_text(req, ver):
        Ok(got): assert(got == want, "`{ver}` vs `{req}` should be {want}")
        Err(e): assert(false, "requirement `{req}` should parse: {e}")

fn check_req_err(req: String):
    match parse_requirement(req):
        Ok(_): assert(false, "expected `{req}` to be rejected")
        Err(_): assert(true, "err as expected")

fn check_cmp(a: String, b: String, want: Int):
    let va = parse_version(a)?; let vb = parse_version(b)?
    assert(version_cmp(va, vb) == want, "cmp({a}, {b}) should be {want}")
    assert(version_cmp(vb, va) == 0 - want, "cmp must be antisymmetric")

fn check_upper_bound(req: String, want: String):
    let r = parse_requirement(req)?
    assert(version_to_string(caret_upper_bound(r.base)) == want, "caret upper bound of {req}")

main():
    // ── strict parsing ──
    check_version("0.0.0", 0, 0, 0)
    check_version("1.2.3", 1, 2, 3); check_version("10.20.30", 10, 20, 30)
    check_version("2147483647.0.1", 2147483647, 0, 1); check_version_err(""); check_version_err("1")
    check_version_err("1.2"); check_version_err("1.2.3.4"); check_version_err("1.2.x")
    check_version_err("v1.2.3"); check_version_err("1..3"); check_version_err("01.0.0")
    check_version_err("1.02.3"); check_version_err("1.2.03"); check_version_err("1.2.-3")
    check_version_err(" 1.2.3"); check_version_err("1.2.3 ")
    // Pre-release and build metadata are out of scope for v0.1.0, and
    // are rejected rather than silently truncated.
    check_version_err("1.2.3-alpha")
    check_version_err("1.2.3+build"); check_version_err("1.2.3-rc.1")
    // Round-trip: parse then render must give back the exact spelling.
    assert(version_to_string(parse_version("7.8.9")?) == "7.8.9", "round-trip")
    println("parse: ok")
    // ── ordering ──
    check_cmp("1.0.0", "1.0.0", 0)
    check_cmp("1.0.0", "1.0.1", 0 - 1); check_cmp("1.0.1", "1.0.0", 1)
    check_cmp("1.0.0", "1.1.0", 0 - 1); check_cmp("2.0.0", "1.99.99", 1)
    check_cmp("0.9.9", "1.0.0", 0 - 1)
    assert(version_eq(parse_version("1.2.3")?, parse_version("1.2.3")?), "eq")
    assert(version_lt(parse_version("1.2.3")?, parse_version("1.2.4")?), "lt")
    assert(version_gte(parse_version("1.2.3")?, parse_version("1.2.3")?), "gte")
    assert(version_lte(parse_version("1.2.2")?, parse_version("1.2.3")?), "lte")
    println("order: ok")
    // ── caret semantics (P-003 3) ──
    check_satisfied("1.2.3", "1.2.3", true)
    check_satisfied("1.2.3", "1.9.0", true); check_satisfied("1.2.3", "1.2.2", false)
    check_satisfied("1.2.3", "2.0.0", false); check_satisfied("1.2.3", "0.9.9", false)
    check_satisfied("0.2.3", "0.2.3", true); check_satisfied("0.2.3", "0.2.9", true)
    check_satisfied("0.2.3", "0.3.0", false); check_satisfied("0.0.3", "0.0.3", true)
    check_satisfied("0.0.3", "0.0.4", false); check_upper_bound("1.2.3", "2.0.0")
    check_upper_bound("0.2.3", "0.3.0"); check_upper_bound("0.0.3", "0.0.4"); println("caret: ok")
    // ── exact pins ──
    check_satisfied("=1.2.3", "1.2.3", true)
    check_satisfied("=1.2.3", "1.2.4", false); check_satisfied("=1.2.3", "1.2.2", false)
    check_satisfied("=0.0.1", "0.0.1", true); check_satisfied("=0.0.1", "0.0.2", false)
    println("exact: ok")
    // ── requirement spelling ──
    check_req_err("")
    check_req_err(">=1.0.0"); check_req_err(">1.0.0"); check_req_err("<2.0.0")
    check_req_err("^1.0.0"); check_req_err("~1.0.0"); check_req_err(">=1.0.0, <2.0.0")
    check_req_err("1.2.3 2.0.0"); check_req_err("=1.2"); check_req_err("=x.y.z")
    check_req_err("=1.2.3.4")
    assert(requirement_to_string(parse_requirement("1.2.3")?) == "1.2.3", "caret renders bare")
    assert(requirement_to_string(parse_requirement("=1.2.3")?) == "=1.2.3", "exact renders with =")
    println("spelling: ok")
    // ── the toolchain and the library agree ──
    // The same requirements a manifest may declare, checked here through
    // the library. A drift between this table and the `nestpkg` crate's
    // caret rules would silently change what a dependency means.
    check_satisfied("0.1.0", "0.1.0", true)
    check_satisfied("0.1.0", "0.1.1", true); check_satisfied("0.1.0", "0.2.0", false)
    check_satisfied("1.0.0", "1.0.0", true); check_satisfied("1.0.0", "1.5.2", true)
    check_satisfied("1.0.0", "2.0.0", false); println("toolchain parity: ok")
    println("semver tests passed")
