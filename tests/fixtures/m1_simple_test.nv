// Test NIR VM with basic operations - no string interpolation
fn add(a: Int, b: Int) -> Int:
    a + b

fn factorial(n: Int) -> Int:
    if n <= 1:
        1
    else:
        n * factorial(n - 1)

main():
    let x = add(3, 4)
    print("3 + 4 = ")
    print(x)
    print("\n")
    let f = factorial(5)
    print("factorial(5) = ")
    print(f)
    print("\n")
    print("M1 test complete!\n")
